# Auto-detect text files, normalize to LF in repo
* text=auto

# Source files
*.kt text eol=lf
*.java text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.c text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ps1 text eol=lf
*.pro text eol=lf

# Scripts (must be executable)
gradlew text eol=lf
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wav binary
*.jar binary
*.so binary
*.apk binary
*.aab binary
