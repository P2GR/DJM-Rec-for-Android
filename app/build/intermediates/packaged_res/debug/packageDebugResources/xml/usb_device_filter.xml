<?xml version="1.0" encoding="utf-8"?>
<!--
    Matches any USB Audio Class (UAC) interface (class 0x01).
    We intentionally do not lock to a single vendor/product ID so that any
    UAC2-compliant mixer (Pioneer DJM-A9, DJM-V10, Xone:96, etc.) is detected.
    Fine-grained interface/endpoint validation happens in UsbAudioManager.
-->
<resources>
    <usb-device class="1" />
</resources>
