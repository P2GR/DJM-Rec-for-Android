# =============================================================================
# Android / Gradle
# =============================================================================

# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
# Android Studio "Generate Signed App Bundle / APK" output folders. Anchored so that
# build-type source sets such as app/src/release/ are never ignored.
/release/
/app/release/
/app/debug/

# Gradle files
.gradle/
.kotlin/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log files and JVM crash/heap dumps (hs_err_pid*.log, replay_pid*.log, *.hprof)
*.log
*.hprof

# Android Studio / IntelliJ
*.iml
*.iws
.idea/
.navigation/
captures/

# External native build folder generated in Android Studio 2.2+
.externalNativeBuild/
.cxx/

# CMake
cmake-build-*/

# NDK
*.o
*.obj

# =============================================================================
# Secrets and signing — never commit these to this public repository
# =============================================================================

# Keystores (the release signing key lives outside the repo; see keystore.properties)
*.jks
*.keystore
*.p12
*.pkcs12
!debug.keystore
*.pem
*.key

# Local credential files (provisioned locally / through GitHub Actions secrets)
keystore.properties
streaming.properties
bugfender.properties
google-services.json
.env
.env.*

# Google Cloud / Firebase service-account keys
*service-account*.json

# =============================================================================
# Third-party source — intentionally NOT vendored
# =============================================================================

# Pioneer DJM-A9 Windows driver — proprietary, not part of this Android app.
# These files were used for reverse-engineering the USB control protocol only.
# Do not commit them to the open-source repository.
windows_driver/
research_drivers/

# LAME (LGPL) must be added manually by the integrator.
# See README.md for instructions.
app/src/main/cpp/third_party/lame/

# =============================================================================
# Editors, OS and local tooling
# =============================================================================
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# Claude Code personal settings (shared .claude/settings.json may be committed)
.claude/settings.local.json
CLAUDE.local.md
