# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/

# Signing files (keep keystores/passwords out of version control!)
*.jks
*.keystore
*.p12
*.pkcs12
!debug.keystore
keystore.properties
streaming.properties

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio
*.iml
.idea/
*.iws

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches
.idea/codeStyles
.idea/modules.xml
.idea/*.iml
.idea/navEditor.xml
.idea/deploymentTargetSelector.xml

# Keystore files
