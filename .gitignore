# app/*.jks
# app/*.keystore

# External native build folder generated in Android Studio 2.2+
.externalNativeBuild/
.cxx/

# CMake
cmake-build-*/

# NDK
*.o
*.obj

# Misc
.DS_Store
Thumbs.db

